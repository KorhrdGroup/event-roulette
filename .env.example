# ─────────────────────────────────────────────────────────────
# 당근 장학금 룰렛 랜딩 — 환경변수 양식 (값은 넣지 않는다 — 이 파일은 git 에 올라간다)
#   로컬: 이 파일을 .env.local 로 복사해서 값을 채운다 (.env.local 은 git 에 안 올라간다)
#   Vercel: Project → Settings → Environment Variables 에 같은 이름으로 넣는다
# ─────────────────────────────────────────────────────────────

# [필수] 한평생오피스 DB(Supabase) — 문의DB 등록 · 룰렛 추첨. 오피스 · 바로소셜과 같은 값
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# [필수] 네이버 클라우드 SENS — 휴대폰 인증번호 문자 (발신번호는 등록된 대표번호 1661-7768 고정). 오피스와 같은 값
NAVER_SENS_ACCESS_KEY=
NAVER_SENS_SECRET_KEY=
NAVER_SENS_SERVICE_ID=

# [선택] 첫 화면 이벤트 (오피스 roulette_events.slug). 비우면 roulette-202612
NEXT_PUBLIC_ROULETTE_SLUG=roulette-202612

# [선택] 상담 신청 접수 알림톡(알리고) — 비우면 보내지 않는다(신청은 그대로 접수). SUBJECT 는 비워도 된다
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER_KEY=
ALIGO_SENDER=
ALIGO_RECEIPT_TEMPLATE_CODE=
ALIGO_RECEIPT_TEMPLATE_MESSAGE=
ALIGO_RECEIPT_TEMPLATE_SUBJECT=
# 알리고는 등록한 IP 에서만 받는다 — Vercel 에서는 고정 IP 프록시를 거친다(바로소셜 · 오피스와 같은 값)
PROXY_URL=
PROXY_SECRET=
